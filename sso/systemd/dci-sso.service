[Unit]
Description=DiamondCrew Interactive Staff SSO relying party
After=network-online.target
Wants=network-online.target

[Service]
User=dci-sso
Group=www-data
SupplementaryGroups=dci-sso
RuntimeDirectory=dci-sso
RuntimeDirectoryMode=0750
StateDirectory=dci-sso
StateDirectoryMode=0700
UMask=0007
LoadCredential=sso.json:/etc/diamondcrew-servercontroller/sso.json
ExecStart=/usr/bin/python3 -B /usr/local/lib/dci-sso/broker.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
