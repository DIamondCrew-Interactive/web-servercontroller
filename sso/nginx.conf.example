# Add inside the existing HTTPS server block. Cockpit's current proxy stays in place.
location /auth/sso/ {
    proxy_pass http://unix:/run/dci-sso/http.sock:;
    proxy_set_header Host $host;
    proxy_set_header Origin $http_origin;
    proxy_set_header X-Forwarded-Proto https;
    proxy_buffering off;
    access_log off; # SSO callback query contains a short-lived one-use ticket.
    add_header Referrer-Policy no-referrer always;
}
# Do NOT proxy /internal/ to the broker.
